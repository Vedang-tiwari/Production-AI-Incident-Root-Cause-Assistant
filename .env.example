# Application Settings
APP_NAME="Production AI Incident & Root-Cause Assistant"
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (Defaults to local SQLite for instant setup; switch to PostgreSQL in production)
DATABASE_URL=sqlite+aiosqlite:///./incident_assistant.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_db

# Redis & Event Queue (Optional - in-memory queue fallback is enabled by default)
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# AI / LLM Configuration
# Supports OpenAI, Gemini, or local fallback mode
LLM_PROVIDER=mock_fallback
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Observability & Integrations
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=

# Anomaly Detection Thresholds
METRIC_LATENCY_THRESHOLD_MS=1000.0
METRIC_CPU_THRESHOLD_PERCENT=85.0
METRIC_MEMORY_THRESHOLD_PERCENT=90.0
METRIC_DB_POOL_THRESHOLD_PERCENT=90.0
METRIC_ERROR_RATE_THRESHOLD_PERCENT=5.0

